# Python caches / build
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtual envs (project env lives outside the repo at C:\conda-envs\drlca-rag)
.venv/
venv/
*.egg-info/

# Secrets -- API keys live in env / Spaces Secrets ONLY, never in the repo
.env
*.env
secrets*.json
*apikey*
*api_key*

# Local run traces / scratch
.playwright-mcp/
*.log
.DS_Store
Thumbs.db

# Resumable judge checkpoint. Written after EVERY call so a 429 mid-run loses
# nothing, but it is scratch -- the durable record is the versioned artifact
# scripts/judge_phase06_results_<model>_<date>.json.
scripts/.judge_phase06_checkpoint.json

# Answer cache: a free-tier QUOTA SAVER, never evidence. Versioned
# test_phase02/judge transcripts are the durable record, and every cache hit is
# marked cached=True so a replay can never be written up as a fresh call.
scripts/.answer_cache.json
scripts/.answer_cache.tmp

# Quota readout (Phase 10 C). COUNTS ONLY -- {"YYYY-MM-DD": {"model": 3}}: a
# date, a model name and an integer, never a word of any conversation. Local and
# ephemeral by design -- on the free host the filesystem is wiped on restart, so
# it is a floor on this instance's spend, never a day's total, and there is
# nothing in it worth versioning.
scripts/.quota_log.json
scripts/.quota_log.tmp
